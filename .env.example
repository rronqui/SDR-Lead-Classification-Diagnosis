# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sdr

# Z-API (WhatsApp)
ZAPI_INSTANCE_ID=your_instance_id
ZAPI_INSTANCE_TOKEN=your_instance_token
ZAPI_SECURITY_TOKEN=your_security_token

# OpenRouter (LLM)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# SerpAPI (Web Search)
SERPAPI_API_KEY=your_serpapi_api_key

# HubSpot (CRM)
HUBSPOT_ACCESS_TOKEN=your_hubspot_access_token
HUBSPOT_OWNER_ID=your_owner_id

# App Config
APP_ENV=dev
LOG_LEVEL=INFO
MAX_PERGUNTAS=6

# LangSmith (Observabilidade)
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=SDR-Lead-Classification-Diagnosis

# Ngrok (Túnel para testes de webhook)
NGROK_AUTHTOKEN=your_ngrok_authtoken
# NGROK_DOMAIN=your-static-domain.ngrok-free.dev